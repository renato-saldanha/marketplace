coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
tests/
test/
*.test.js
*.spec.js

# Ambiente e configuração
.env*
!.env.production.example
.vscode
.idea
*.swp
*.swo
*~

# Git
.git
.gitignore
.gitattributes
.github

# Documentação
*.md
!README.md
DOCS/
docs/

