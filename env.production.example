# ========================================
# CONFIGURAÇÃO DE PRODUÇÃO - MARKETPLACE
# ========================================
# IMPORTANTE: Copie este arquivo para .env.production e preencha com valores reais
# NUNCA commite arquivos .env com dados sensíveis!

# ========================================
# INFORMAÇÕES DE BUILD
# ========================================
BUILD_DATE=2024-01-01T00:00:00Z
VERSION=1.0.0

# ========================================
# BANCO DE DADOS POSTGRESQL
# ========================================
# ATENÇÃO: Use senhas fortes e únicas em produção!
POSTGRES_DB=marketplace_db
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=MUDE_ESTA_SENHA_AGORA_123456789

# ========================================
# BACKEND - SEGURANÇA
# ========================================
# SECRET_KEY: Chave secreta para JWT
# Gere uma nova: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=MUDE_ESTA_CHAVE_SECRETA_AGORA_USE_UMA_CHAVE_LONGA_E_ALEATORIA_123456789

# Algoritmo de criptografia
ALGORITHM=HS256

# Tempo de expiração do token (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# BACKEND - CONFIGURAÇÕES
# ========================================
# Tamanho máximo de upload (em bytes) - 10MB
MAX_UPLOAD_SIZE=10485760

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ========================================
# CORS - ORIGENS PERMITIDAS
# ========================================
# Liste todos os domínios que podem acessar a API
# Separe múltiplos domínios com vírgula
ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# ========================================
# FRONTEND - URL DA API
# ========================================
# URL pública da API (sem barra no final)
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# ========================================
# REDIS (CACHE)
# ========================================
# Senha do Redis
REDIS_PASSWORD=MUDE_ESTA_SENHA_REDIS_123456789

# ========================================
# MONITORAMENTO (OPCIONAL)
# ========================================
# Sentry para rastreamento de erros
SENTRY_DSN=

# ========================================
# EMAIL (OPCIONAL - PARA NOTIFICAÇÕES)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_FROM=noreply@seudominio.com

# ========================================
# BACKUP AUTOMÁTICO
# ========================================
# Habilitar backup automático (true/false)
ENABLE_AUTO_BACKUP=true

# Horário do backup (formato cron)
BACKUP_SCHEDULE=0 2 * * *

# Número de backups para manter
BACKUP_RETENTION_DAYS=7

# ========================================
# DOMÍNIO E SSL
# ========================================
# Seu domínio principal
DOMAIN=seudominio.com

# Email para certificado SSL (Let's Encrypt)
SSL_EMAIL=seu-email@seudominio.com

# ========================================
# CONFIGURAÇÕES DE PERFORMANCE
# ========================================
# Número de workers do Gunicorn
GUNICORN_WORKERS=4

# Timeout de requisições (segundos)
GUNICORN_TIMEOUT=120

# ========================================
# RATE LIMITING
# ========================================
# Requisições por minuto por IP
RATE_LIMIT_PER_MINUTE=60

# ========================================
# OUTRAS CONFIGURAÇÕES
# ========================================
# Timezone
TZ=America/Sao_Paulo

# Idioma padrão
DEFAULT_LANGUAGE=pt-BR

